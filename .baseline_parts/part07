entById("b-sound"), bNew=document.getElementById("b-new");
function toggleSpeed(){ S.speed=S.speed===1?2:S.speed===2?4:1; bSpeed.textContent=S.speed+"\u00d7"; }
function toggleSound(){ S.muted=!S.muted; bSound.classList.toggle("off",S.muted); if(!S.muted) blip(520,0.08); }
bSpeed.addEventListener("click",toggleSpeed);
bSound.addEventListener("click",toggleSound);
bSound.classList.add("off");
bNew.addEventListener("click",()=>{
  if(confirm("Start a brand new valley? This clears the town you've built.")){
    genWorld((Math.random()*1e9)|0); mileHit=0; save(); toast("A fresh valley");
  }
});
document.getElementById("b-start").addEventListener("click",()=>{
  document.getElementById("veil").classList.add("hide");
  pickTool("road");
});

/* ============================================================
   SAVE / LOAD  (guarded — falls back to a session-only game)
   ============================================================ */
const KEY="meadowline.v1";
const store={
  get(){try{return localStorage.getItem(KEY);}catch(e){return null;}},
  set(v){try{localStorage.setItem(KEY,v);}catch(e){}}
};
function save(){
  const b=[];
  for(let i=0;i<S.grid.length;i++){
    const x=S.grid[i]; if(!x) continue;
    b.push([x.type,x.x,x.y,x.pop]);
  }
  let woods="";
  for(let i=0;i<S.natTree.length;i++) woods+=S.natTree[i]?"1":"0";
  store.set(JSON.stringify({v:1,seed:S.seed,coins:Math.floor(S.coins),day:S.day,dayT:S.dayT,b,woods,mile:mileHit}));
}
function load(){
  const raw=store.get(); if(!raw) return false;
  try{
    const d=JSON.parse(raw);
    if(!d||d.v!==1) return false;
    genWorld(d.seed);
    S.coins=d.coins; S.day=d.day; S.dayT=d.dayT; mileHit=d.mile||0;
    if(typeof d.woods==="string"&&d.woods.length===S.natTree.length){
      for(let i=0;i<d.woods.length;i++) S.natTree[i]=d.woods[i]==="1"?1:0;
    }
    for(const[type,x,y,pop] of d.b){
      if(!inBounds(x,y)) continue;
      S.natTree[idx(x,y)]=0;
      S.grid[idx(x,y)]={type,x,y,seed:((x*73856093)^(y*19349663))>>>0,pop:pop||0,grow:0,mood:50,linked:false};
    }
    recompute();
    return true;
  }catch(e){ return false; }
}
let saveT=0;
addEventListener("visibilitychange",()=>{ if(document.hidden) save(); });
addEventListener("pagehide",save);

/* ============================================================
   MAIN LOOP
   ============================================================ */
let last=performance.now();
function frame(now){
  let dt=(now-last)/1000; last=now;
  dt=Math.min(dt,0.05);
  const sdt=dt*(S.running?S.speed:0);

  S.t+=dt;
  if(sdt>0){
    const prev=S.dayT;
    S.dayT+=sdt/DAY;
    if(S.dayT>=1){ S.dayT-=1; S.day++; payday(); }
    simT+=sdt;
    if(simT>0.9){ simT=0; recompute(); checkMiles(); }
    growth(sdt);
    updateCitizens(sdt);
    updateTrains(sdt);
  }
  updatePuffs(dt);

  uiT+=dt; if(uiT>0.2){ uiT=0; paintHud(); paintTools(); }
  if(hintT>0){ hintT-=dt; if(hintT<=0) elHint.classList.remove("show"); }
  saveT+=dt; if(saveT>6){ saveT=0; save(); }

  render();
  requestAnimationFrame(frame);
}

/* ---------- boot ---------- */
resize();
if(!load()) genWorld(S.seed);
paintHud(); paintTools();
requestAnimationFrame(frame);
hint("Pick a tool below and start with a road.");

})();
</script>
