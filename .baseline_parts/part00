<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#1d2b26">
<meta name="description" content="Meadowline — a small, calm city builder. Lay roads and rails, plant parks, watch trains run and citizens stroll. No timers, no fail state.">
<title>Meadowline — a calm little city builder</title>
<style>
  :root{
    --ink:#1d2b26;
    --ink-soft:#2b3d36;
    --cream:#f4f0e2;
    --cream-dim:#c9c6b4;
    --mustard:#e0ae4e;
    --meadow:#8fbe74;
    --rose:#d3897c;
    --sky:#8fc4d6;
    --shadow:0 10px 30px rgba(12,22,18,.35);
    --r:16px;
    font-family:"Nunito","Quicksand",ui-rounded,"SF Pro Rounded","Trebuchet MS",system-ui,sans-serif;
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0;overscroll-behavior:none}
  body{
    background:#6fa86a;color:var(--cream);
    -webkit-tap-highlight-color:transparent;
    -webkit-user-select:none;user-select:none;
    touch-action:none;
  }
  canvas{display:block;width:100%;height:100%;position:fixed;inset:0}

  /* ---------- top status strip ---------- */
  .hud{
    position:fixed;top:calc(env(safe-area-inset-top,0px) + 10px);left:50%;transform:translateX(-50%);
    display:flex;gap:2px;align-items:stretch;
    background:rgba(29,43,38,.86);backdrop-filter:blur(8px);
    border-radius:999px;box-shadow:var(--shadow);
    padding:5px;max-width:calc(100vw - 20px);
  }
  .stat{display:flex;flex-direction:column;justify-content:center;padding:5px 14px;border-radius:999px;line-height:1.15}
  .stat b{font-size:15px;font-weight:800;letter-spacing:.2px;white-space:nowrap}
  .stat span{font-size:9.5px;text-transform:uppercase;letter-spacing:.13em;color:var(--cream-dim);font-weight:700}
  .stat + .stat{box-shadow:inset 1px 0 0 rgba(244,240,226,.12)}
  .stat.coins b{color:var(--mustard)}
  .stat.mood b{color:var(--meadow)}

  /* ---------- corner buttons ---------- */
  .corner{
    position:fixed;top:calc(env(safe-area-inset-top,0px) + 10px);right:10px;
    display:flex;flex-direction:column;gap:8px;
  }
  .chip{
    width:42px;height:42px;border:0;border-radius:14px;cursor:pointer;
    background:rgba(29,43,38,.86);color:var(--cream);backdrop-filter:blur(8px);
    box-shadow:var(--shadow);display:grid;place-items:center;
    font:inherit;font-size:12px;font-weight:800;transition:transform .12s ease,background .12s ease;
  }
  .chip:hover{background:rgba(43,61,54,.94)}
  .chip:active{transform:scale(.93)}
  .chip.off{color:#7d8a83}

  /* ---------- bottom dock ---------- */
  .dock{
    position:fixed;left:50%;transform:translateX(-50%);
    bottom:calc(env(safe-area-inset-bottom,0px) + 10px);
    background:rgba(29,43,38,.88);backdrop-filter:blur(8px);
    border-radius:22px;box-shadow:var(--shadow);
    padding:8px;max-width:calc(100vw - 16px);
  }
  .tools{display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;padding:1px}
  .tools::-webkit-scrollbar{display:none}
  .tool{
    flex:0 0 auto;width:64px;padding:8px 4px 6px;border:0;border-radius:15px;cursor:pointer;
    background:transparent;color:var(--cream-dim);font:inherit;
    display:flex;flex-direction:column;align-items:center;gap:3px;
    transition:background .12s ease,color .12s ease,transform .1s ease;
  }
  .tool svg{width:26px;height:26px}
  .tool i{font-style:normal;font-size:10.5px;font-weight:800;letter-spacing:.02em}
  .tool u{text-decoration:none;font-size:9.5px;font-weight:700;color:var(--mustard);opacity:.85}
  .tool:hover{background:rgba(244,240,226,.07);color:var(--cream)}
  .tool:active{transform:scale(.94)}
  .tool.on{background:var(--cream);color:var(--ink)}
  .tool.on u{color:#8a6a1e;opacity:1}
  .tool.broke{opacity:.38}
  .tool.on.broke{opacity:.55}

  /* ---------- hint line ---------- */
  .hint{
    position:fixed;left:50%;transform:translateX(-50%);
    bottom:calc(env(safe-area-inset-bottom,0px) + 108px);
    background:rgba(29,43,38,.8);backdrop-filter:blur(6px);
    padding:6px 14px;border-radius:999px;font-size:12.5px;font-weight:700;
    color:var(--cream);box-shadow:var(--shadow);white-space:nowrap;
    max-width:calc(100vw - 24px);overflow:hidden;text-overflow:ellipsis;
    opacity:0;transition:opacity .35s ease;pointer-events:none;
  }
  .hint.show{opacity:1}

  /* ---------- toasts ---------- */
  .toasts{
    position:fixed;left:50%;transform:translateX(-50%);
    top:calc(env(safe-area-inset-top,0px) + 66px);
    display:flex;flex-direction:column;align-items:center;gap:6px;pointer-events:none;
  }
  .toast{
    background:rgba(29,43,38,.92);color:var(--cream);
    padding:7px 15px;border-radius:999px;font-size:13px;font-weight:800;
    box-shadow:var(--shadow);animation:pop .4s cubic-bezier(.2,1.4,.4,1);
  }
  .toast.gold{color:var(--mustard)}
  @keyframes pop{from{opacity:0;transform:translateY(-10px) scale(.9)}to{opacity:1;transform:none}}
  .toast.out{opacity:0;transform:translateY(-8px);transition:opacity .5s ease,transform .5s ease}

  /* ---------- welcome card ---------- */
  .veil{
    position:fixed;inset:0;background:rgba(16,26,22,.55);backdrop-filter:blur(3px);
    display:grid;place-items:center;padding:18px;z-index:20;
  }
  .veil.hide{display:none}
  .card{
    background:var(--ink);border-radius:24px;box-shadow:var(--shadow);
    padding:26px 24px;max-width:380px;width:100%;
  }
  .card h1{margin:0 0 2px;font-size:27px;letter-spacing:-.02em;font-weight:800}
  .card p.sub{margin:0 0 16px;color:var(--mustard);font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .card ul{margin:0 0 20px;padding:0;list-style:none;display:flex;flex-direction:column;gap:9px}
  .card li{display:flex;gap:10px;font-size:13.5px;line-height:1.45;color:#ded9c8}
  .card li b{color:var(--cream)}
  .card li em{flex:0 0 auto;width:22px;text-align:center;font-style:normal;color:var(--meadow);font-weight:800}
