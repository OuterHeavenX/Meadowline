function idx(x,y){return y*W+x;}
function inBounds(x,y){return x>=0&&y>=0&&x<W&&y<H;}
function at(x,y){return inBounds(x,y)?S.grid[idx(x,y)]:null;}
function isType(x,y,t){const b=at(x,y);return !!b&&b.type===t;}

/* ---------- world generation ---------- */
function genWorld(seed){
  S.seed=seed;
  S.terr=new Uint8Array(W*H);
  S.natTree=new Uint8Array(W*H);
  S.grid=new Array(W*H).fill(null);
  const s=seed%9973;
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const i=idx(x,y);
    // ponds: organic blobs, kept away from the very centre so there's room to build
    const cd=Math.hypot(x-W/2,y-H/2)/(W/2);
    const w=fbm(x/11,y/11,s);
    if(w>0.68+0.13*(1-cd)) S.terr[i]=1;
    // natural woodland in clusters
    const f=fbm(x/6.5,y/6.5,s+404);
    if(!S.terr[i]&&f>0.585&&hash2(x,y,s+9)>0.45) S.natTree[i]=1;
  }
  S.citizens.length=0; S.trains.length=0; S.puffs.length=0;
  S.coins=340; S.day=1; S.dayT=0.24; S.t=0;
  centreCamera();
  recompute();
}

function centreCamera(){
  S.cam.z=Math.min(1.15,Math.max(0.62,Math.min(innerWidth/900,innerHeight/620)));
  const p=world2screen(W/2,H/2);
  S.cam.x=innerWidth/2-p.x*S.cam.z;
  S.cam.y=innerHeight/2-p.y*S.cam.z;
}

/* ---------- iso transforms ---------- */
function world2screen(x,y){return {x:(x-y)*(TW/2), y:(x+y)*(TH/2)};}
function screen2world(sx,sy){
  const wx=(sx-S.cam.x)/S.cam.z, wy=(sy-S.cam.y)/S.cam.z;
  const a=wy/(TH/2), b=wx/(TW/2);
  return {x:(a+b)/2, y:(a-b)/2};
}
function proj(x,y){const p=world2screen(x,y);return {x:p.x*S.cam.z+S.cam.x, y:p.y*S.cam.z+S.cam.y};}

/* ---------- building placement ---------- */
const BUILDABLE={road:1,rail:1,house:1,cafe:1,park:1,tree:1,station:1};

function canPlace(kind,x,y){
  if(!inBounds(x,y)) return {ok:false};
  const i=idx(x,y);
  if(S.terr[i]===1) return {ok:false,why:"You can't build on water."};
  const cur=S.grid[i];
  if(cur){
    if(cur.type===kind) return {ok:false};
    return {ok:false,why:"Something's already there — remove it first."};
  }
  if(kind==="station"){
    let touching=false;
    for(const[dx,dy]of DIRS) if(isType(x+dx,y+dy,"rail")) touching=true;
    if(!touching) return {ok:false,why:"Stations have to touch a rail tile."};
  }
  if(S.coins<COST[kind]) return {ok:false,why:"Not enough coins yet — wait for the next payday."};
  return {ok:true};
}

function place(kind,x,y){
  const r=canPlace(kind,x,y);
  if(!r.ok){ if(r.why) hint(r.why,true); return false; }
  const i=idx(x,y);
  S.coins-=COST[kind];
  S.natTree[i]=0;
  S.grid[i]={type:kind,x,y,seed:((x*73856093)^(y*19349663))>>>0,pop:0,grow:0,mood:50,linked:false};
  puff(x,y);
  blip(kind==="house"?520:kind==="park"?400:340);
  return true;
}

function erase(x,y){
  if(!inBounds(x,y)) return false;
  const i=idx(x,y);
  const b=S.grid[i];
  if(!b){
    if(S.natTree[i]){ S.natTree[i]=0; puff(x,y); blip(240); return true; }
    return false;
  }
  S.coins+=Math.floor(COST[b.type]/2);
  S.grid[i]=null;
  puff(x,y);
  blip(220);
  return true;
}

/* ---------- simulation ---------- */
let simT=0;
function recompute(){
  const parks=[],cafes=[],stations=[],houses=[];
  for(let i=0;i<S.grid.length;i++){
    const b=S.grid[i]; if(!b) continue;
    if(b.type==="park") parks.push(b);
    else if(b.type==="cafe") cafes.push(b);
    else if(b.type==="station") stations.push(b);
    else if(b.type==="house") houses.push(b);
  }
  let pop=0,moodSum=0;
  for(const h of houses){
    let onRoad=false;
    for(const[dx,dy]of DIRS) if(isType(h.x+dx,h.y+dy,"road")) onRoad=true;
    h.linked=onRoad;
    if(!onRoad){                       // nothing else matters until a road reaches it
      h.mood=14; pop+=h.pop; moodSum+=14;
      continue;
    }
    let m=66;
    let park=0;
    for(const p of parks){ if(Math.abs(p.x-h.x)<=4&&Math.abs(p.y-h.y)<=4) park+=13; }
    m+=Math.min(park,26);
    let cafe=0;
    for(const c of cafes){ if(Math.abs(c.x-h.x)<=5&&Math.abs(c.y-h.y)<=5) cafe+=10; }
    m+=Math.min(cafe,20);
    let st=0;
    for(const s of stations){ if(Math.abs(s.x-h.x)<=6&&Math.abs(s.y-h.y)<=6) st+=16; }
    m+=Math.min(st,16);
    let green=0;
    for(let dy=-3;dy<=3;dy++)for(let dx=-3;dx<=3;dx++){
      const x=h.x+dx,y=h.y+dy; if(!inBounds(x,y)) continue;
      const i2=idx(x,y);
      if(S.natTree[i2]||isType(x,y,"tree")) green+=1.5;
      if(S.terr[i2]===1) green+=1;
    }
    m+=Math.min(green,12);
    let crowd=0;
    for(let dy=-2;dy<=2;dy++)for(let dx=-2;dx<=2;dx++) if(isType(h.x+dx,h.y+dy,"house")) crowd++;
    if(crowd>7) m-=(crowd-7)*4;
    h.mood=clamp(Math.round(m),0,100);
    pop+=h.pop;
    moodSum+=h.mood;
  }
  S.homes=houses.length;
  S.pop=pop;
  S.mood=houses.length?Math.round(moodSum/houses.length):0;
  S._cafes=cafes.length; S._houses=houses;
  paintTools();
}

function growth(dt){
  for(const h of S._houses||[]){
    const cap=4;
    if(!h.linked){ h.grow=0; if(h.pop>0&&Math.random()<dt*0.05) h.pop--; continue; }
    if(h.pop<cap&&h.mood>=62){
      h.grow+=dt*(h.mood-55)/60;
      if(h.grow>=6){ h.grow=0; h.pop++; hearts(h.x,h.y); }
    } else if(h.mood<32&&h.pop>0){
      h.grow-=dt*0.4;
      if(h.grow<-8){ h.grow=0; h.pop--; }
    } else h.grow*=(1-dt*0.1);
  }
}

/* ---------- citizens ---------- */
function roadNear(x,y){
  for(const[dx,dy]of DIRS) if(isType(x+dx,y+dy,"road")) return {x:x+dx,y:y+dy};
  return null;
}
function stepFrom(x,y,px,py,type){
  const opts=[],back=[];
  for(const[dx,dy]of DIRS){
    const nx=x+dx,ny=y+dy;
    if(!isType(nx,ny,type)) continue;
    if(nx===px&&ny===py) back.push([nx,ny]); else opts.push([nx,ny]);
  }
  const pool=opts.length?opts:back;
  if(!pool.length) return null;
  return pool[(Math.random()*pool.length)|0];
}
